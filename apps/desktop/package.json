{
    "name": "desktop",
    "version": "1.0.7",
    "description": "Electrobun app with React, Tailwind CSS, and Vite HMR",
    "scripts": {
        "start": "vite build && electrobun dev",
        "dev": "electrobun dev --watch",
        "dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
        "hmr": "vite --port 5173",
        "build:canary": "vite build && electrobun build --env=canary && bun run rename-artifacts",
        "build:stable": "vite build && electrobun build --env=stable && bun run rename-artifacts",
        "rename-artifacts": "bun run scripts/rename-artifacts.ts"
    },
    "dependencies": {
        "electrobun": "1.18.1",
        "react": "^19.2.7",
        "react-dom": "^19.2.7"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.1",
        "@types/bun": "latest",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@types/three": "^0.184.1",
        "@vitejs/plugin-react": "^6.0.2",
        "concurrently": "^9.2.3",
        "tailwindcss": "^4.3.1",
        "typescript": "^6.0.3",
        "vite": "^8.0.16"
    }
}
